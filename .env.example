# Server Configuration
PORT=3000
# Set to 1 when running behind a TLS-terminating reverse proxy (nginx, Caddy,
# Traefik, ...). Enables secure cookies and correct client IPs.
TRUST_PROXY=0

# Session secret — REQUIRED in production. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Initial admin account (created only on first start, when no users exist).
# If ADMIN_PASS is empty or a common placeholder, a random password is
# generated and printed once to the server log. Change it after first login.
ADMIN_USER=admin
ADMIN_PASS=

# --- Site branding / defaults (all optional; also editable in the admin panel) ---
SITE_NAME=My CMS
SITE_LOGO_TEXT=CMS
SITE_TAGLINE=A flexible, content-managed website
SITE_HERO_TITLE=Welcome
SITE_HERO_SUBTITLE=Every word on this page is editable from the admin panel.
SITE_HERO_CTA=Get in touch
SITE_HERO_BG=https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&w=1920&q=80
SITE_PRIMARY_COLOR=#ff3366
SITE_SECONDARY_COLOR=#7b2cbf
SITE_CONTACT_HEADING=Contact
SITE_CONTACT_INTRO=Send a message and we will get back to you.
SITE_FOOTER_TEXT=© 2026 My CMS. All rights reserved.
# Used for sitemap.xml and SEO meta tags, e.g. https://example.com
SITE_URL=
SITE_META_DESCRIPTION=
# Comma-separated locales to enable per-entry languages, e.g. "de,en"
CONTENT_LOCALES=
# Optional webhook that receives a POST on every content change
WEBHOOK_URL=

# --- SMTP (optional; leave SMTP_HOST empty to disable email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM='My CMS' <noreply@example.com>
SMTP_TO=inbox@example.com
